{
  "name": "kairos-os",
  "productName": "KAIROS OS Beta",
  "version": "0.9.4",
  "description": "KAIROS OS Beta: futures replay for the group",
  "main": "main.js",
  "author": "King",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kairos.os",
    "productName": "KAIROS OS Beta",
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "splash-preload.js",
      "web/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KAIROS-OS-Beta-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "KAIROS OS",
      "uninstallDisplayName": "KAIROS OS Beta",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "meyerjos004",
        "repo": "rewind",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://meyerjos004.github.io/rewind/"
}
